# Active platform adapter: TELEGRAM or WHATSAPP
ACTIVE_PLATFORM=TELEGRAM

# Telegram API credentials from https://my.telegram.org
TG_API_ID=your_telegram_api_id
TG_API_HASH=your_telegram_api_hash
TG_PHONE_NUMBER=+1234567890

# Target Telegram bot username or chat handle
INSTINCT_TG_USERNAME=@instinct_telegram_bot

# WhatsApp (WAHA) configuration (used when ACTIVE_PLATFORM=WHATSAPP)
WAHA_BASE_URL=http://localhost:3000
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_WEBHOOK_SECRET=
WAHA_WEBHOOK_URL=http://host.docker.internal:8000/webhooks/whatsapp
WAHA_AUTO_CONFIGURE=true
INSTINCT_WA_NUMBER=16508702892@c.us

# Bearer API key required on all /v1/* endpoints (leave blank to bypass auth in local dev)
PROXY_API_KEY=your_secure_api_key

# Optional tuning parameters
TG_SESSION_NAME=instinct_session
TG_SESSION_DIR=
REPLY_SETTLE_SECONDS=1.8
RESPONSE_TIMEOUT_SECONDS=60.0
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
